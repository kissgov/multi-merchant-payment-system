{
  "name": "payment-admin-pc",
  "version": "1.0.0",
  "description": "多商户移动支付收款系统 - PC管理后台（支持Electron桌面应用）",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "type-check": "vue-tsc --noEmit",
    "preview": "vite preview",
    "electron:dev": "vite build && electron .",
    "electron:build": "vite build && electron-builder",
    "electron:build:win": "vite build && electron-builder --win --x64",
    "electron:build:mac": "vite build && electron-builder --mac",
    "lint": "eslint src --ext .vue,.ts --fix"
  },
  "dependencies": {
    "vue": "^3.4.0",
    "vue-router": "^4.3.0",
    "pinia": "^2.1.0",
    "element-plus": "^2.6.0",
    "@element-plus/icons-vue": "^2.3.0",
    "axios": "^1.6.0",
    "echarts": "^5.5.0",
    "vue-echarts": "^6.6.0",
    "dayjs": "^1.11.0",
    "nprogress": "^0.2.0",
    "js-cookie": "^3.0.0",
    "qrcode": "^1.5.0",
    "lodash-es": "^4.17.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "vite": "^5.1.0",
    "typescript": "^5.3.0",
    "vue-tsc": "^2.0.0",
    "unplugin-auto-import": "^0.17.0",
    "unplugin-vue-components": "^0.26.0",
    "sass": "^1.71.0",
    "@types/node": "^20.0.0",
    "@types/nprogress": "^0.2.0",
    "@types/js-cookie": "^3.0.0",
    "@types/qrcode": "^1.5.0",
    "@types/lodash-es": "^4.17.0",
    "electron": "^29.0.0",
    "electron-builder": "^24.13.0"
  },
  "main": "electron/main.js",
  "build": {
    "appId": "com.payment.admin",
    "productName": "支付管理后台",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icon.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "public/icon.png"
    }
  }
}
