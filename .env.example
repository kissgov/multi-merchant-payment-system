# ========= 服务端口 =========
PORT=3000

# ========= JWT 配置（生产环境务必修改） =========
JWT_SECRET=please-change-this-to-a-long-random-secret-key-payment-system
JWT_EXPIRES_IN=24h

# ========= 数据库类型 =========
# mysql（默认，生产/宝塔使用） | sqlite（仅云端无 MySQL 调试用）
# 留空或不设置 = mysql
DB_TYPE=mysql

# ========= MySQL 数据库配置 =========
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=your_db_user
DB_PASSWORD="your_db_password"
DB_DATABASE=payment_system

# ========= 支付回调公网地址 =========
# 必须是 HTTPS 公网可访问地址，支付宝/微信回调会发送到此地址
# 例如：https://pay.your-domain.com
PAYMENT_NOTIFY_BASE_URL=https://your-public-domain.com

# ========= 支付配置说明 =========
# 支付配置存储在数据库 merchants 表中（支持多商户各自独立配置）
# 门店也可配置独立支付参数（stores 表 useIndependentPayment=true 时逐字段优先）
#
# 【支付宝】在商户管理页面配置：
#   alipayAppId       - 支付宝应用 APPID
#   alipayPrivateKey  - 支付宝应用私钥（RSA2，PEM 格式或纯 Base64）
#   alipayPublicKey    - 支付宝公钥（用于验签）
#   alipaySandbox      - 是否沙箱环境
#
# 【微信支付 V3】在商户管理页面配置：
#   wechatAppId       - 微信公众号/小程序 AppID
#   wechatMchId       - 微信商户号
#   wechatApiV3Key    - APIv3 密钥（微信商户平台设置的 32 位密钥）
#   wechatMchSerialNo - 商户证书序列号
#   wechatPrivateKey  - 商户私钥（PEM 格式，从商户 API 证书中提取）
#   wechatSandbox     - 是否沙箱环境
